# Backend — producción con Supabase (Postgres + Storage)
NODE_ENV=production

# Preferir pooler (IPv4). El host directo db.*.supabase.co a menudo solo resuelve IPv6.
DATABASE_URL=postgresql://postgres.wynihzrohhlflqftgogr:[YOUR-DB-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres
DB_SSL=true

# Alternativa directa (requiere IPv6 en el runtime):
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.wynihzrohhlflqftgogr.supabase.co:5432/postgres

JWT_SECRET=[GENERATE_A_LONG_RANDOM_SECRET]
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=30

# Supabase Storage (mismo proyecto)
SUPABASE_URL=https://wynihzrohhlflqftgogr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]
SUPABASE_BUCKET=[YOUR_BUCKET_NAME]

# Frontend / CORS
VITE_API_URL=https://plataforma-informes.vercel.app/api
CORS_ORIGIN=https://plataforma-informes.vercel.app
